// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

struct Plane
{
    float distance;
    float3 normal;
};

struct DrawData {
    float3 position;
    float4 rotation;
    float3 scale;
};

struct InstanceLODData {
    float3 position0;
    float4 rotation0;
    float3 scale0;
    float3 position1;
    float4 rotation1;
    float3 scale1;
};

// in: per-instance data with rotation/scale for both LOD levels
StructuredBuffer<InstanceLODData> draw_buffer;
// in: how many item locations
int num_to_draw;
// in: holds information about the camera's frustum planes
StructuredBuffer<Plane> planes;

// in: agent (player) world position for LOD selection
float3 agent_position;
// in: distance threshold — below uses LOD1 (low poly), above uses LOD0 (high poly)
float lod_distance;
// in: whether each LOD mesh is assigned (1 = assigned, 0 = not)
int has_lod1;
int has_lod0;

// out: unculled items close to agent (LOD1, high poly)
AppendStructuredBuffer<DrawData> unculled_lod1_buf;
// out: unculled items far from agent (LOD0, low poly)
AppendStructuredBuffer<DrawData> unculled_lod0_buf;

[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x > (uint) num_to_draw-1) return;

    InstanceLODData src = draw_buffer[id.x];

    // Cull using position0 (both LODs share approximately the same world location)
    float3 pos0 = src.position0;

    // ensures loop is unrolled at compile time
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        if (dot(planes[i].normal, pos0) + planes[i].distance < -0.2f)
            return; // culled
    }

    DrawData d;

    // If both LODs are present, split by distance; otherwise route to whichever is assigned
    if (has_lod1 && has_lod0)
    {
        if (distance(pos0, agent_position) < lod_distance)
        {
            d.position = pos0;
            d.rotation = src.rotation0;
            d.scale    = src.scale0;
            unculled_lod0_buf.Append(d);
        }
        else
        {
            d.position = src.position1;
            d.rotation = src.rotation1;
            d.scale    = src.scale1;
            unculled_lod1_buf.Append(d);
        }
    }
    else if (has_lod1)
    {
        d.position = src.position1;
        d.rotation = src.rotation1;
        d.scale    = src.scale1;
        unculled_lod1_buf.Append(d);
    }
    else
    {
        d.position = pos0;
        d.rotation = src.rotation0;
        d.scale    = src.scale0;
        unculled_lod0_buf.Append(d);
    }
}
