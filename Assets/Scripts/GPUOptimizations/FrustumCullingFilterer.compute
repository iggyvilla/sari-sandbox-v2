// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain

#define MAX_LODS 4

struct Plane
{
    float distance;
    float3 normal;
};

// in: per-instance culling positions shared by all LOD levels
StructuredBuffer<float4> position_buffer;
// in: how many item locations
int num_to_draw;
// in: holds information about the camera's frustum planes
StructuredBuffer<Plane> planes;

// in: agent (player) world position for LOD selections
float3 agent_position;
// in: squared distance thresholds, ASCENDING (inner → outer), one per LOD level:
//   lod_distances[j] = max distance squared for lods[j]
//   indices 0..num_lods-2 drive LOD selection; index num_lods-1 is the hard cull distance
//   (instance is skipped entirely if distSq >= lod_distances[num_lods - 1])
float4 lod_distances;
// in: number of active LOD levels (1–4); unused slots are never written to
int num_lods;

// out: one compact visible-instance index list per LOD level
// (HLSL cannot declare these as an array — named outputs are the unavoidable constraint)
AppendStructuredBuffer<uint> lod0_buf;
AppendStructuredBuffer<uint> lod1_buf;
AppendStructuredBuffer<uint> lod2_buf;
AppendStructuredBuffer<uint> lod3_buf;

[numthreads(512,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) num_to_draw) return;

    float3 cullPos = position_buffer[id.x].xyz;

    [unroll]
    for (int i = 0; i < 6; i++)
    {
        if (dot(planes[i].normal, cullPos) + planes[i].distance < -0.2f)
            return; // culled
    }

    float3 toAgent = cullPos - agent_position;
    float distSq = dot(toAgent, toAgent);

    // Hard cull: lod_distances[num_lods - 1] is the max distance for the farthest LOD.
    // Anything beyond it is dropped entirely — not just switched to a lower-quality mesh.
    if (distSq >= lod_distances[num_lods - 1]) return;

    // Select LOD: default to the farthest, then walk from LOD0 outward to find the
    // highest-quality level whose threshold (lod_distances[j]) we're still within.
    int lodIdx = num_lods - 1;
    for (int j = 0; j < num_lods - 1; j++)
    {
        if (distSq < lod_distances[j]) { lodIdx = j; break; }
    }

    // Append the source instance index to the right named buffer. The material shader
    // uses this compact visible list to fetch position + per-LOD transform data.
    switch (lodIdx)
    {
        case 0: lod0_buf.Append(id.x); break;
        case 1: lod1_buf.Append(id.x); break;
        case 2: lod2_buf.Append(id.x); break;
        case 3: lod3_buf.Append(id.x); break;
    }
}
