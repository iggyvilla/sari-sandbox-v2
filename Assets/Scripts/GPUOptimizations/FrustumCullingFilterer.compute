// GPU-driven culling for every instanced product: one Cull dispatch covers all batches.
// ClearCounts -> Cull -> WriteArgs, recorded per viewer (camera or LiDAR).
#pragma kernel ClearCounts
#pragma kernel Cull
#pragma kernel WriteArgs

// Keep in sync with InstanceCullingSystem.
#define CULL_FRUSTUM   1
#define CULL_RANGE     2
#define CULL_OCCLUSION 4
#define MAX_LODS       4

struct InstanceCullData
{
    float4 sphere;   // world bounding sphere enclosing every LOD (xyz = center, w = radius)
    float3 position; // LOD selection / draw position
    uint id;         // batch index << 16 | index within the batch
};

struct BatchCullData
{
    float4 lodDistancesSq; // squared max distance per LOD, ascending; [numLods - 1] is the hard cull
    uint numLods;
    uint visibleOffset;    // start of this batch's regions in `visible` (one region of `count` per LOD)
    uint count;
    uint pad;
};

StructuredBuffer<InstanceCullData> instances;
StructuredBuffer<BatchCullData> batches;
StructuredBuffer<uint> args_sources; // per indirect-args entry: its counter index (batch * MAX_LODS + lod)
RWStructuredBuffer<uint> counts;     // visible instances per (batch, LOD)
RWStructuredBuffer<uint> visible;    // compact per-(batch, LOD) lists of in-batch instance indices
RWStructuredBuffer<uint> args;       // indirect draw args, 5 uints per entry
int num_instances;
int num_counters;
int num_args;

// in: camera frustum planes (xyz = normal, w = distance); points inside satisfy dot(n, p) + d >= 0
float4 planes[6];
int cull_flags;
// in: origin for LOD selection and distance culling (camera or LiDAR position)
float4 cull_origin;
// in: LiDAR range culling radius squared (CULL_RANGE only)
float range_max_distance_sq;

// in (CULL_OCCLUSION): max-reduced linear eye depth pyramid of this frame's depth prepass
Texture2D<float> hiz_texture;
float4x4 hiz_world_to_view;
// x = proj[0][0], y = proj[1][1], z = near plane, w = depth bias (meters)
float4 hiz_projection;
// x = width, y = height, z = mip count (URP stores the depth texture bottom-up, so V needs no flip)
float4 hiz_size;

[numthreads(64, 1, 1)]
void ClearCounts(uint3 id : SV_DispatchThreadID)
{
    if (id.x < (uint)num_counters) counts[id.x] = 0;
}

float LoadHiZ(float2 uv, int mip)
{
    int2 mipSize = max(int2(hiz_size.xy) >> mip, 1);
    int2 texel = clamp(int2(uv * mipSize), 0, mipSize - 1);
    return hiz_texture.Load(int3(texel, mip));
}

// True when the whole sphere is behind the farthest occluder depth covering its screen rect.
bool IsOccluded(float4 sphere)
{
    float3 viewCenter = mul(hiz_world_to_view, float4(sphere.xyz, 1.0)).xyz;
    float centerDepth = -viewCenter.z;
    float nearestDepth = centerDepth - sphere.w;
    if (nearestDepth <= hiz_projection.z) return false;

    // Conservative screen rect: the projected radius over the nearest depth, plus a 10% margin.
    float2 ndcCenter = viewCenter.xy * hiz_projection.xy / centerDepth;
    float2 ndcRadius = 1.1 * sphere.w * hiz_projection.xy / nearestDepth;
    float2 uvMin = saturate((ndcCenter - ndcRadius) * 0.5 + 0.5);
    float2 uvMax = saturate((ndcCenter + ndcRadius) * 0.5 + 0.5);

    // Pick the mip where the rect spans at most one texel, so its 4 corner texels cover it.
    float2 extentPixels = (uvMax - uvMin) * hiz_size.xy;
    int mip = (int)ceil(log2(max(max(extentPixels.x, extentPixels.y), 1.0)));
    mip = clamp(mip, 0, (int)hiz_size.z - 1);

    float occluderDepth = max(
        max(LoadHiZ(uvMin, mip), LoadHiZ(float2(uvMax.x, uvMin.y), mip)),
        max(LoadHiZ(float2(uvMin.x, uvMax.y), mip), LoadHiZ(uvMax, mip)));

    return nearestDepth > occluderDepth + hiz_projection.w;
}

[numthreads(64, 1, 1)]
void Cull(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)num_instances) return;

    InstanceCullData instance = instances[id.x];
    uint batchIndex = instance.id >> 16;
    BatchCullData batch = batches[batchIndex];

    if (cull_flags & CULL_FRUSTUM)
    {
        [unroll]
        for (int i = 0; i < 6; i++)
        {
            if (dot(planes[i].xyz, instance.sphere.xyz) + planes[i].w < -instance.sphere.w)
                return;
        }
    }

    float3 toOrigin = instance.position - cull_origin.xyz;
    float distSq = dot(toOrigin, toOrigin);

    // LiDAR keeps everything within its range (drawn with the farthest LOD past the LOD table);
    // cameras hard-cull at the farthest LOD distance.
    if (cull_flags & CULL_RANGE)
    {
        if (distSq > range_max_distance_sq) return;
    }
    else if (distSq >= batch.lodDistancesSq[batch.numLods - 1])
    {
        return;
    }

    if ((cull_flags & CULL_OCCLUSION) && IsOccluded(instance.sphere)) return;

    uint lod = batch.numLods - 1;
    for (uint j = 0; j < batch.numLods - 1; j++)
    {
        if (distSq < batch.lodDistancesSq[j]) { lod = j; break; }
    }

    uint slot;
    InterlockedAdd(counts[batchIndex * MAX_LODS + lod], 1, slot);
    visible[batch.visibleOffset + lod * batch.count + slot] = instance.id & 0xFFFF;
}

[numthreads(64, 1, 1)]
void WriteArgs(uint3 id : SV_DispatchThreadID)
{
    if (id.x < (uint)num_args) args[id.x * 5 + 1] = counts[args_sources[id.x]];
}
