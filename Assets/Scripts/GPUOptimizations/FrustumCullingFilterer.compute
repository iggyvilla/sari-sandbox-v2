#pragma kernel CSMain

// Keep in sync with BatchInstancer.CullFrustum / CullRange / CullOcclusion.
#define CULL_FRUSTUM   1
#define CULL_RANGE     2
#define CULL_OCCLUSION 4

// in: per-instance LOD/draw positions shared by all LOD levels
StructuredBuffer<float4> position_buffer;
// in: per-instance world bounding sphere (xyz = center, w = radius) enclosing every LOD mesh
StructuredBuffer<float4> sphere_buffer;
int num_to_draw;

// in: camera frustum planes (xyz = normal, w = distance); points inside satisfy dot(n, p) + d >= 0
float4 planes[6];
int cull_flags;

// in: origin for LOD selection and distance culling (camera or LiDAR position)
float4 cull_origin;
// in: LiDAR range culling radius squared (CULL_RANGE only)
float range_max_distance_sq;
// in: squared max distance per LOD, ascending; [num_lods - 1] is the hard cull distance
float4 lod_distances;
int num_lods;

// in (CULL_OCCLUSION): max-reduced linear eye depth pyramid of this frame's depth prepass
Texture2D<float> hiz_texture;
float4x4 hiz_world_to_view;
// x = proj[0][0], y = proj[1][1], z = near plane, w = depth bias (meters)
float4 hiz_projection;
// x = width, y = height, z = mip count (URP stores the depth texture bottom-up, so V needs no flip)
float4 hiz_size;

// out: one compact visible-instance index list per LOD level
// (HLSL cannot declare these as an array — named outputs are the unavoidable constraint)
AppendStructuredBuffer<uint> lod0_buf;
AppendStructuredBuffer<uint> lod1_buf;
AppendStructuredBuffer<uint> lod2_buf;
AppendStructuredBuffer<uint> lod3_buf;

float LoadHiZ(float2 uv, int mip)
{
    int2 mipSize = max(int2(hiz_size.xy) >> mip, 1);
    int2 texel = clamp(int2(uv * mipSize), 0, mipSize - 1);
    return hiz_texture.Load(int3(texel, mip));
}

// True when the whole sphere is behind the farthest occluder depth covering its screen rect.
bool IsOccluded(float4 sphere)
{
    float3 viewCenter = mul(hiz_world_to_view, float4(sphere.xyz, 1.0)).xyz;
    float centerDepth = -viewCenter.z;
    float nearestDepth = centerDepth - sphere.w;
    if (nearestDepth <= hiz_projection.z) return false;

    // Conservative screen rect: the projected radius over the nearest depth, plus a 10% margin.
    float2 ndcCenter = viewCenter.xy * hiz_projection.xy / centerDepth;
    float2 ndcRadius = 1.1 * sphere.w * hiz_projection.xy / nearestDepth;
    float2 uvMin = saturate((ndcCenter - ndcRadius) * 0.5 + 0.5);
    float2 uvMax = saturate((ndcCenter + ndcRadius) * 0.5 + 0.5);
    // Pick the mip where the rect spans at most one texel, so its 4 corner texels cover it.
    float2 extentPixels = (uvMax - uvMin) * hiz_size.xy;
    int mip = (int)ceil(log2(max(max(extentPixels.x, extentPixels.y), 1.0)));
    mip = clamp(mip, 0, (int)hiz_size.z - 1);

    float occluderDepth = max(
        max(LoadHiZ(uvMin, mip), LoadHiZ(float2(uvMax.x, uvMin.y), mip)),
        max(LoadHiZ(float2(uvMin.x, uvMax.y), mip), LoadHiZ(uvMax, mip)));

    return nearestDepth > occluderDepth + hiz_projection.w;
}

[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) num_to_draw) return;

    float4 sphere = sphere_buffer[id.x];

    if (cull_flags & CULL_FRUSTUM)
    {
        [unroll]
        for (int i = 0; i < 6; i++)
        {
            if (dot(planes[i].xyz, sphere.xyz) + planes[i].w < -sphere.w)
                return;
        }
    }

    float3 toOrigin = position_buffer[id.x].xyz - cull_origin.xyz;
    float distSq = dot(toOrigin, toOrigin);

    // LiDAR keeps everything within its range (drawn with the farthest LOD past the LOD table);
    // cameras hard-cull at the farthest LOD distance.
    if (cull_flags & CULL_RANGE)
    {
        if (distSq > range_max_distance_sq) return;
    }
    else if (distSq >= lod_distances[num_lods - 1])
    {
        return;
    }

    if ((cull_flags & CULL_OCCLUSION) && IsOccluded(sphere)) return;

    int lodIdx = num_lods - 1;
    for (int j = 0; j < num_lods - 1; j++)
    {
        if (distSq < lod_distances[j]) { lodIdx = j; break; }
    }

    switch (lodIdx)
    {
        case 0: lod0_buf.Append(id.x); break;
        case 1: lod1_buf.Append(id.x); break;
        case 2: lod2_buf.Append(id.x); break;
        case 3: lod3_buf.Append(id.x); break;
    }
}
