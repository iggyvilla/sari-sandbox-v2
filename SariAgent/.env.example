# Copy this file to .env and fill in your local values.
#
# Format:
# KEY=value
# Blank lines and lines starting with # are ignored.

# OpenAI or OpenAI-compatible model settings.
SARI_MODEL=Qwen/Qwen3.6-27N
SARI_OPENAI_API_KEY=replace-with-your-api-key
# Use responses for OpenAI Responses API, or chat_completions for most external servers.
SARI_OPENAI_API_STYLE=chat_completions

# Optional external OpenAI-compatible API endpoint.
# Leave blank to use the OpenAI SDK default endpoint.
# Examples:
# SARI_OPENAI_BASE_URL=https://api.openai.com/v1
# SARI_OPENAI_BASE_URL=http://localhost:8000/v1
SARI_OPENAI_BASE_URL=

# Unity command WebSocket.
SARI_UNITY_HOST=localhost
SARI_UNITY_PORT=8080
# Larger screenshots are base64-encoded and can exceed the websocket 1 MiB default.
# Set to 0 to disable the receive limit.
SARI_UNITY_MAX_MESSAGE_BYTES=16777216

# Agent local paths. Relative paths resolve from the SariAgent folder.
SARI_MEMORY_DIR=memory
SARI_SCREENSHOT_DIR=screenshots

# Loop control.
SARI_MAX_LOOP_ITERATIONS=8

# Optional browser debug stream.
SARI_DEBUG_ENABLED=0
SARI_DEBUG_HOST=localhost
SARI_DEBUG_PORT=8765
SARI_DEBUG_REPLAY_EVENTS=1000
SARI_DEBUG_INCLUDE_RAW_LLM_EVENTS=1
SARI_DEBUG_INCLUDE_PROMPTS=1
SARI_DEBUG_IMAGE_MAX_EDGE=512
SARI_DEBUG_RUNS_DIR=debug_runs
